#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF 999999

struct Edge {
    int src;
    int dest;
    int weight;
};

void bellmanFord(struct Edge edges[], int V, int E, int source) {
    int distance[V + 1];
    int parent[V + 1];

    // Step 1: Initialize distances
    for (int i = 1; i <= V; i++) {
        distance[i] = INF;
        parent[i] = -1;
    }

    distance[source] = 0;

    // Step 2: Relax all edges V-1 times
    for (int i = 1; i <= V - 1; i++) {

        for (int j = 0; j < E; j++) {

            int u = edges[j].src;
            int v = edges[j].dest;
            int w = edges[j].weight;

            if (distance[u] != INF &&
                distance[u] + w < distance[v]) {

                distance[v] = distance[u] + w;
                parent[v] = u;
            }
        }
    }

    // Step 3: Check for negative weight cycle
    for (int j = 0; j < E; j++) {

        int u = edges[j].src;
        int v = edges[j].dest;
        int w = edges[j].weight;

        if (distance[u] != INF &&
            distance[u] + w < distance[v]) {

            printf("Negative cycle detected\n");
            return;
        }
    }

    // Step 4: Print shortest distance and path
    for (int i = 1; i <= V; i++) {

        if (i == source)
            continue;

        if (distance[i] == INF) {
            printf("%d INF None\n", i);
        }
        else {
            int path[V + 1];
            int count = 0;
            int current = i;

            // Store path in reverse order
            while (current != -1) {
                path[count++] = current;
                current = parent[current];
            }

            printf("%d %d ", i, distance[i]);

            // Print path in correct order
            for (int j = count - 1; j >= 0; j--) {

                printf("%d", path[j]);

                if (j != 0)
                    printf("->");
            }

            printf("\n");
        }
    }
}

int main() {

    int V, E, source;

    scanf("%d", &V);
    scanf("%d", &E);

    struct Edge edges[E];

    // Input edges
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d",
              &edges[i].src,
              &edges[i].dest,
              &edges[i].weight);
    }

    // Input source
    scanf("%d", &source);

    bellmanFord(edges, V, E, source);

    return 0;
}
